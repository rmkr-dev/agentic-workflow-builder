# Provider-neutral LLM configuration (names only — never commit real secrets)
#
# Default is mock mode (AGENTFORGE_LLM_MOCK=1) for deterministic local/CI runs.
# For live OpenAI-compatible calls:
#   AGENTFORGE_LLM_MOCK=0
#   AGENTFORGE_LLM_API_KEY=sk-...
# Optional: OPENAI_API_KEY is also accepted if AGENTFORGE_LLM_API_KEY is empty.
AGENTFORGE_LLM_PROVIDER=openai
AGENTFORGE_LLM_MODEL=gpt-4o-mini
AGENTFORGE_LLM_API_KEY=
AGENTFORGE_LLM_BASE_URL=
AGENTFORGE_LLM_MOCK=1
